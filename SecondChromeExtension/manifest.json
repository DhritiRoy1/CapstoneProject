{
    "manifest_version": 3,
    "name": "URL Tracker",
    "description": "Track and analyze your browsing patterns",
    "version": "0.0.0.1",
    "permissions": ["storage", "tabs", "activeTab", "webRequest", "webNavigation"],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "background": {
        "service_worker": "script.js"
    },
    "host_permissions": [
        "<all_urls>"
    ]
}
